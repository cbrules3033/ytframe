#include <winver.h>

1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     1,3,1,0
PRODUCTVERSION  1,3,1,0
FILEOS          0x40004L
FILETYPE        0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "cbrules3033"
            VALUE "FileDescription",  "YTFrame - borderless video player"
            VALUE "FileVersion",      "1.3.1"
            VALUE "InternalName",     "YTFrame"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "YTFrame.exe"
            VALUE "ProductName",      "YTFrame"
            VALUE "ProductVersion",   "1.3.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
